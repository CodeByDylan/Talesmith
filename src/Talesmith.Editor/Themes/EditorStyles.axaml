<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="https://talesmith.dev/ui">

  <!-- Surfaces floating over the viewport: the tool rail, zoom controls and notices -->
  <Style Selector="Border.floating">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusLarge}" />
    <Setter Property="BoxShadow" Value="{DynamicResource ShadowRaised}" />
    <Setter Property="Padding" Value="4" />
  </Style>
  <Style Selector="Border.floating Button, Border.floating ToggleButton">
    <Setter Property="Focusable" Value="False" />
  </Style>
  <Style Selector="Border.floating ToggleButton.tool">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="CornerRadius" Value="7" />
  </Style>

  <!-- The app bar: a thin accent line and a tinted background while playing -->
  <Style Selector="Border.appbar">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector=":is(Control).playing Border.appbar">
    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
  </Style>
  <Style Selector="Border.play-strip">
    <Setter Property="Height" Value="2" />
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector=":is(Control).playing Border.play-strip">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector=":is(Control).paused Border.play-strip">
    <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
  </Style>

  <Style Selector="Border.appbar Button, Border.appbar ToggleButton, Border.toolstrip Button, Border.toolstrip ToggleButton">
    <Setter Property="Focusable" Value="False" />
  </Style>

  <!-- The toolbar row with the active tool's options -->
  <Style Selector="Border.toolstrip">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="Padding" Value="10,0" />
  </Style>
  <Style Selector="Border.toolstrip TextBlock.label">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.toolstrip ComboBox">
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="8,0,4,0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="ToggleButton.option">
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="ToggleButton.option ui|SymbolIcon">
    <Setter Property="Size" Value="14" />
  </Style>

  <!-- Toggles beside a panel's tabs, such as the Scene panel's grid and the Game panel's window preview -->
  <Style Selector="ToggleButton.header">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="22" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="ToggleButton.header:checked">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- Status bar text -->
  <Style Selector="TextBlock.status">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="ui|SymbolIcon.status">
    <Setter Property="Size" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="ui|SymbolIcon.status.success">
    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
  </Style>
  <Style Selector="ui|SymbolIcon.status.warning">
    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
  </Style>
  <Style Selector="ui|SymbolIcon.status.error">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
  </Style>
  <Style Selector="ui|SymbolIcon.status.busy">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- Status bar items, clickable when they have a command -->
  <Style Selector="Button.status-item">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="5,1" />
    <Setter Property="Margin" Value="-5,0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusSmall}" />
  </Style>
  <Style Selector="Button.status-item /template/ Border#PART_Root">
    <Setter Property="BoxShadow" Value="none" />
  </Style>

  <!-- An icon that turns while work runs -->
  <Style Selector="ui|SymbolIcon.spin">
    <Setter Property="RenderTransform">
      <RotateTransform />
    </Setter>
    <Style.Animations>
      <Animation Duration="0:0:1.1" IterationCount="Infinite">
        <KeyFrame Cue="0%">
          <Setter Property="RotateTransform.Angle" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="RotateTransform.Angle" Value="360" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- A list row whose content stretches -->
  <Style Selector="ListBox.rows ListBoxItem">
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
</Styles>
