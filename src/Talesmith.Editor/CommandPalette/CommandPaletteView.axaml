<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="https://talesmith.dev/ui"
             xmlns:vm="using:Talesmith.Editor.CommandPalette"
             x:Class="Talesmith.Editor.CommandPalette.CommandPaletteView"
             x:DataType="vm:CommandPaletteViewModel"
             VerticalAlignment="Top"
             Margin="0,90,0,0">
  <UserControl.Styles>
    <Style Selector="TextBox#SearchBox /template/ Border#PART_BorderElement, TextBox#SearchBox:focus /template/ Border#PART_BorderElement, TextBox#SearchBox:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BoxShadow" Value="none" />
    </Style>
  </UserControl.Styles>
  <Border Width="640"
          Background="{DynamicResource SurfaceRaisedBrush}"
          BorderBrush="{DynamicResource BorderStrongBrush}"
          BorderThickness="1"
          CornerRadius="12"
          BoxShadow="{DynamicResource ShadowPopup}"
          ClipToBounds="True">
    <DockPanel>
      <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="16,4,12,4">
        <ui:SymbolIcon Data="{x:Static ui:Icons.Search}" Size="18" Foreground="{DynamicResource TextMutedBrush}" />
        <TextBox Name="SearchBox" Grid.Column="1"
                 Text="{Binding Query}"
                 PlaceholderText="{Binding Placeholder}"
                 FontSize="15"
                 Background="Transparent"
                 BorderThickness="0"
                 BorderBrush="Transparent"
                 FocusAdorner="{x:Null}"
                 Padding="10,12">
          <TextBox.Resources>
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
          </TextBox.Resources>
        </TextBox>
        <ui:ShortcutBadge Grid.Column="2" Text="Esc" VerticalAlignment="Center" />
      </Grid>
      <Border DockPanel.Dock="Top" Classes="divider-h" Margin="0" />
      <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,Auto,*,Auto" Margin="16,8">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <ui:ShortcutBadge Text="↑" />
          <ui:ShortcutBadge Text="↓" />
          <TextBlock Classes="caption muted" Text="Navigate" VerticalAlignment="Center" Margin="2,0,16,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
          <ui:ShortcutBadge Text="Enter" />
          <TextBlock Classes="caption muted" Text="Run" VerticalAlignment="Center" />
        </StackPanel>
        <ItemsControl Grid.Column="3" ItemsSource="{Binding Hints}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="14" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PaletteHint">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <ui:ShortcutBadge Text="{Binding Prefix}" />
                <TextBlock Classes="caption muted" Text="{Binding Category}" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
      <Border DockPanel.Dock="Bottom" Classes="divider-h" Margin="0" />
      <Panel>
        <ListBox Name="ResultList"
                 Classes="sidebar"
                 Margin="6"
                 MaxHeight="400"
                 Background="Transparent"
                 ItemsSource="{Binding Results}"
                 SelectedItem="{Binding SelectedItem}">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:PaletteItem">
              <Grid ColumnDefinitions="Auto,12,*,Auto,12,Auto" Opacity="{Binding IsEnabled, Converter={x:Static vm:PaletteConverters.EnabledOpacity}}">
                <Border Width="28" Height="28" CornerRadius="7" Background="{DynamicResource SurfaceSunkenBrush}">
                  <ui:SymbolIcon Data="{Binding Icon}" Size="14" />
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                  <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="caption muted" Text="{Binding Subtitle}" IsVisible="{Binding HasSubtitle}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="3" Classes="caption muted" Text="{Binding Category}" VerticalAlignment="Center" />
                <ui:ShortcutBadge Grid.Column="5" Text="{Binding GestureText}" IsVisible="{Binding HasGesture}" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Margin="24" Spacing="6" HorizontalAlignment="Center" IsVisible="{Binding !HasResults}">
          <ui:SymbolIcon Data="{x:Static ui:Icons.Search}" Size="22" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
          <TextBlock Classes="muted" Text="Nothing matches" HorizontalAlignment="Center" />
        </StackPanel>
      </Panel>
    </DockPanel>
  </Border>
</UserControl>
