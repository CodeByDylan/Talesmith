<DataTemplates xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:ui="https://talesmith.dev/ui"
               xmlns:f="using:Talesmith.Editor.Particles.Fields">

  <DataTemplate DataType="f:NumberValue">
    <ui:PropertyRow Label="{Binding Label}" Description="{Binding Tooltip}" IsVisible="{Binding IsVisible}">
      <ui:NumberField Value="{Binding Value}" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Step="{Binding Step}"
                      FormatString="{Binding FormatString}" Suffix="{Binding Suffix}" IsInteger="{Binding IsInteger}" />
    </ui:PropertyRow>
  </DataTemplate>

  <DataTemplate DataType="f:ToggleValue">
    <ui:PropertyRow Label="{Binding Label}" Description="{Binding Tooltip}" IsVisible="{Binding IsVisible}">
      <CheckBox IsChecked="{Binding Value}" MinHeight="0" Padding="0" />
    </ui:PropertyRow>
  </DataTemplate>

  <DataTemplate DataType="f:ChoiceValue">
    <ui:PropertyRow Label="{Binding Label}" Description="{Binding Tooltip}" IsVisible="{Binding IsVisible}">
      <Panel>
        <ui:SegmentedControl ItemsSource="{Binding Options}" SelectedIndex="{Binding SelectedIndex}" IsVisible="{Binding IsSegmented}"
                             HorizontalAlignment="Stretch" Classes="fill" />
        <ComboBox ItemsSource="{Binding Options}" SelectedIndex="{Binding SelectedIndex}" IsVisible="{Binding IsList}"
                  HorizontalAlignment="Stretch" MinHeight="26" />
      </Panel>
    </ui:PropertyRow>
  </DataTemplate>

  <DataTemplate DataType="f:VectorValue">
    <ui:PropertyRow Label="{Binding Label}" Description="{Binding Tooltip}" IsVisible="{Binding IsVisible}">
      <ui:Vector2Field Value="{Binding Value}" Step="1" FormatString="0.##" />
    </ui:PropertyRow>
  </DataTemplate>

  <DataTemplate DataType="f:ColorValue">
    <ui:PropertyRow Label="{Binding Label}" Description="{Binding Tooltip}" IsVisible="{Binding IsVisible}">
      <ui:ColorPickerButton Color="{Binding Value}" />
    </ui:PropertyRow>
  </DataTemplate>

  <DataTemplate DataType="f:TextValue">
    <ui:PropertyRow Label="{Binding Label}" Description="{Binding Tooltip}" IsVisible="{Binding IsVisible}">
      <TextBox Text="{Binding Value}" MinHeight="26" />
    </ui:PropertyRow>
  </DataTemplate>

  <DataTemplate DataType="f:RangeValue">
    <ui:PropertyRow Label="{Binding Label}" Description="{Binding Tooltip}" IsVisible="{Binding IsVisible}">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
        <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
          <ui:NumberField Grid.ColumnSpan="2" Value="{Binding Min}" Minimum="{Binding Minimum}" Step="{Binding Step}" Suffix="{Binding Suffix}"
                          FormatString="0.###" IsVisible="{Binding IsConstant}" />
          <ui:NumberField Value="{Binding Min}" Minimum="{Binding Minimum}" Step="{Binding Step}" Suffix="{Binding Suffix}" FormatString="0.###"
                          Label="min" IsVisible="{Binding IsRandom}" />
          <ui:NumberField Grid.Column="1" Value="{Binding Max}" Minimum="{Binding Minimum}" Step="{Binding Step}" Suffix="{Binding Suffix}"
                          FormatString="0.###" Label="max" IsVisible="{Binding IsRandom}" />
        </Grid>
        <ToggleButton Grid.Column="2" Classes="icon small range-toggle" IsChecked="{Binding IsRandom}"
                      ToolTip.Tip="Random between two values for each particle">
          <ui:SymbolIcon Data="{x:Static ui:Icons.Dice}" Size="14" />
        </ToggleButton>
      </Grid>
    </ui:PropertyRow>
  </DataTemplate>

  <DataTemplate DataType="f:ColorRangeValue">
    <ui:PropertyRow Label="{Binding Label}" Description="{Binding Tooltip}" IsVisible="{Binding IsVisible}">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
        <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
          <ui:ColorPickerButton Grid.ColumnSpan="2" Color="{Binding From}" IsVisible="{Binding !IsRandom}" />
          <ui:ColorPickerButton Color="{Binding From}" IsVisible="{Binding IsRandom}" />
          <ui:ColorPickerButton Grid.Column="1" Color="{Binding To}" IsVisible="{Binding IsRandom}" />
        </Grid>
        <ToggleButton Grid.Column="2" Classes="icon small range-toggle" IsChecked="{Binding IsRandom}"
                      ToolTip.Tip="Random blend between two colors for each particle">
          <ui:SymbolIcon Data="{x:Static ui:Icons.Dice}" Size="14" />
        </ToggleButton>
      </Grid>
    </ui:PropertyRow>
  </DataTemplate>

  <DataTemplate DataType="f:CurveValue">
    <ui:PropertyRow Label="{Binding Label}" Description="{Binding Tooltip}" IsVisible="{Binding IsVisible}">
      <ui:CurvePreview Curve="{Binding Value}" />
    </ui:PropertyRow>
  </DataTemplate>

  <DataTemplate DataType="f:GradientValue">
    <ui:PropertyRow Label="{Binding Label}" Description="{Binding Tooltip}" IsVisible="{Binding IsVisible}">
      <ui:GradientPreview Gradient="{Binding Value}" />
    </ui:PropertyRow>
  </DataTemplate>

  <DataTemplate DataType="f:AssetValue">
    <ui:PropertyRow Label="{Binding Label}" Description="{Binding Tooltip}" IsVisible="{Binding IsVisible}">
      <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected}" HorizontalAlignment="Stretch" MinHeight="26" />
    </ui:PropertyRow>
  </DataTemplate>

  <DataTemplate DataType="f:ListValue">
    <StackPanel Spacing="4" IsVisible="{Binding IsVisible}" Margin="0,2,0,4">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="{Binding Label}" Classes="secondary" FontSize="12" ToolTip.Tip="{Binding Tooltip}" />
          <TextBlock Text="{Binding CountText}" Classes="caption muted" VerticalAlignment="Center" />
        </StackPanel>
        <Button Grid.Column="1" Classes="subtle small" Command="{Binding AddCommand}">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <ui:SymbolIcon Data="{x:Static ui:Icons.Plus}" Size="12" />
            <TextBlock Text="{Binding AddText}" />
          </StackPanel>
        </Button>
      </Grid>
      <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="4" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="f:ListItem">
            <Border Classes="list-item">
              <DockPanel>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,2">
                  <TextBlock Text="{Binding Title}" Classes="caption" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="icon small" Command="{Binding RemoveCommand}" ToolTip.Tip="Remove">
                    <ui:SymbolIcon Data="{x:Static ui:Icons.X}" Size="12" />
                  </Button>
                </Grid>
                <ItemsControl ItemsSource="{Binding Fields}" />
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </DataTemplate>
</DataTemplates>
