<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="https://talesmith.dev/ui"
             xmlns:vm="using:Talesmith.Editor.Assets.Creation"
             x:Class="Talesmith.Editor.Assets.Creation.CreateScriptView"
             x:DataType="vm:CreateScriptViewModel">
  <ui:Dialog Header="New C# script" Description="Scripts in the scripts folder compile automatically and hot-reload while you play." Width="460">
    <StackPanel Spacing="14">
      <StackPanel Spacing="6">
        <TextBlock Classes="caption muted" Text="Class name" />
        <TextBox Name="Input" Classes="mono" Text="{Binding ClassName}" />
        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasError}">
          <ui:SymbolIcon Data="{x:Static ui:Icons.AlertCircle}" Size="13" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Top" Margin="0,1,0,0" />
          <TextBlock Text="{Binding Error}" Classes="caption" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" MaxWidth="380" />
        </StackPanel>
      </StackPanel>
      <StackPanel Spacing="6">
        <TextBlock Classes="caption muted" Text="Template" />
        <ui:SegmentedControl ItemsSource="{Binding Templates}" SelectedIndex="{Binding TemplateIndex}" HorizontalAlignment="Left" />
        <TextBlock Text="{Binding TemplateDescription}" Classes="caption muted" TextWrapping="Wrap" />
      </StackPanel>
      <Border Classes="card" Padding="10,8">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <ui:SymbolIcon Data="{x:Static ui:Icons.FileCode}" Size="14" Foreground="#10B981" />
          <TextBlock Text="{Binding FileName}" Classes="mono caption" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Border>
    </StackPanel>
    <ui:Dialog.Footer>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Cancel" MinWidth="84" IsCancel="True" Command="{Binding CancelCommand}" />
        <Button Classes="accent" Content="Create" MinWidth="84" IsDefault="True" Command="{Binding ConfirmCommand}" />
      </StackPanel>
    </ui:Dialog.Footer>
  </ui:Dialog>
</UserControl>
