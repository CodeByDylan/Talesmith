<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="https://talesmith.dev/ui"
             xmlns:vm="using:Talesmith.Editor.Assets.Inspectors"
             x:Class="Talesmith.Editor.Assets.Inspectors.DocumentInspectorView"
             x:DataType="vm:DocumentInspection">
  <ui:PropertyGroup Header="Contents" Icon="{x:Static ui:Icons.ListTree}">
    <StackPanel Spacing="8">
      <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Classes="caption" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding EntityText}" FontWeight="Medium" FontSize="12" />
      <ItemsControl ItemsSource="{Binding Roots}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,1">
              <ui:SymbolIcon Data="{x:Static ui:Icons.Box}" Size="12" Foreground="{DynamicResource TextMutedBrush}" />
              <TextBlock Text="{Binding}" FontSize="12" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="Components" Classes="caption muted" Margin="0,4,0,0" />
      <ItemsControl ItemsSource="{Binding Components}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:DocumentStat">
            <Border CornerRadius="10" Padding="8,1" Margin="0,0,4,4" Background="{DynamicResource SurfaceSunkenBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <TextBlock Text="{Binding Name}" FontSize="11" />
                <TextBlock Text="{Binding Value}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ui:PropertyGroup>
</UserControl>
