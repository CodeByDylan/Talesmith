<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="https://talesmith.dev/ui"
             xmlns:vm="using:Talesmith.Editor.Assets.Browser"
             x:Class="Talesmith.Editor.Assets.Browser.AssetBrowserView"
             x:DataType="vm:AssetBrowserViewModel"
             Focusable="True">
  <UserControl.Styles>
    <!-- Tiles -->
    <Style Selector="Border.tile">
      <Setter Property="Padding" Value="6,6,6,5" />
      <Setter Property="Margin" Value="0,0,4,4" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.08" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.tile:pointerover">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>
    <Style Selector="Border.tile.selected">
      <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Border.tile.drop, Border.row.drop">
      <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Border.tile.cut, Border.row.cut">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="Border.thumb">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.tile TextBlock.title">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Border.tile:pointerover TextBlock.title, Border.tile.selected TextBlock.title">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Border.badge">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="Margin" Value="4" />
      <Setter Property="Padding" Value="4,0,4,1" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBox.rename">
      <Setter Property="MinHeight" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="FontSize" Value="11.5" />
    </Style>

    <!-- List rows -->
    <Style Selector="Border.row">
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="Margin" Value="4,0" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.row:pointerover">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>
    <Style Selector="Border.row.selected">
      <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
    </Style>
    <Style Selector="Border.row TextBlock.cell">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Button.header">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Height" Value="22" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>

    <!-- Breadcrumbs and tree -->
    <Style Selector="Button.crumb">
      <Setter Property="Padding" Value="5,1" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Height" Value="24" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Button.crumb.last">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="Border.crumb-drop">
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.crumb-drop.drop, Border.node.drop">
      <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Border.node">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Padding" Value="2,0,6,0" />
    </Style>
    <Style Selector="TreeView#Folders TreeViewItem">
      <Setter Property="MinHeight" Value="24" />
    </Style>

    <!-- Kind chips -->
    <Style Selector="ToggleButton.kind">
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Margin" Value="0,0,4,4" />
    </Style>
    <Style Selector="Border.dropzone">
      <Setter Property="IsVisible" Value="False" />
      <Setter Property="Margin" Value="6" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Border.dropzone.active">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <!-- Toolbar -->
    <ui:SplitBar DockPanel.Dock="Top" Margin="8,6,8,6" FirstGrows="True" Spacing="4" RowSpacing="4">
      <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="4" MinWidth="240">
        <Button Name="CreateButton" Classes="small" ToolTip.Tip="Create an asset in this folder" IsEnabled="{Binding IsReady}">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <ui:SymbolIcon Data="{x:Static ui:Icons.Plus}" Size="13" />
            <TextBlock Text="Create" FontSize="12" VerticalAlignment="Center" />
            <ui:SymbolIcon Data="{x:Static ui:Icons.ChevronDown}" Size="11" Foreground="{DynamicResource TextMutedBrush}" />
          </StackPanel>
        </Button>
        <Button Grid.Column="1" Classes="icon small" Command="{Binding ImportCommand}" ToolTip.Tip="Import files into this folder (or drop them on the panel)" IsEnabled="{Binding IsReady}">
          <ui:SymbolIcon Data="{x:Static ui:Icons.Import}" Size="14" />
        </Button>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="0" Margin="8,0,8,0" VerticalAlignment="Center" ClipToBounds="True">
          <Button Classes="icon small" Command="{Binding GoUpCommand}" IsEnabled="{Binding CanGoUp}" ToolTip.Tip="Up one folder (Backspace)" Margin="0,0,4,0">
            <ui:SymbolIcon Data="{x:Static ui:Icons.ArrowUp}" Size="13" />
          </Button>
          <Panel>
            <ItemsControl Name="Crumbs" ItemsSource="{Binding Breadcrumbs}" IsVisible="{Binding !IsSearching}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:BreadcrumbViewModel">
                  <StackPanel Orientation="Horizontal">
                    <Border Classes="crumb-drop" Tag="{Binding Path}" DragDrop.AllowDrop="True">
                      <Button Classes="subtle crumb" Classes.last="{Binding IsLast}" Content="{Binding Name}"
                              Command="{Binding $parent[UserControl].((vm:AssetBrowserViewModel)DataContext).OpenFolderCommand}" CommandParameter="{Binding Path}" />
                    </Border>
                    <ui:SymbolIcon Data="{x:Static ui:Icons.ChevronRight}" Size="11" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding !IsLast}" Margin="1,0" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsSearching}" VerticalAlignment="Center">
              <ui:SymbolIcon Data="{x:Static ui:Icons.Search}" Size="13" Foreground="{DynamicResource AccentBrush}" />
              <TextBlock Text="Searching all assets" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
              <Button Classes="subtle small" Command="{Binding ClearSearchCommand}" Padding="6,0" Height="22" MinHeight="0">
                <TextBlock Text="Clear" FontSize="11" />
              </Button>
            </StackPanel>
          </Panel>
        </StackPanel>
      </Grid>
      <WrapPanel ItemSpacing="4" LineSpacing="4" ItemsAlignment="End">
        <ui:SearchBox Name="SearchField" Text="{Binding Search}" PlaceholderText="Search  (kind:  tag:  guid)" Width="220" />
        <ToggleButton Name="FilterButton" Classes="icon small" Classes.accent="{Binding HasKindFilter}" ToolTip.Tip="Filter by kind">
          <ui:SymbolIcon Data="{x:Static ui:Icons.Filter}" Size="14" />
          <ToggleButton.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <StackPanel Width="300" Spacing="8" Margin="4">
                <TextBlock Text="Show only" Classes="caption muted" />
                <ItemsControl ItemsSource="{Binding KindFilters}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:KindFilterViewModel">
                      <ToggleButton Classes="chip kind" IsChecked="{Binding IsChecked}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                          <ui:SymbolIcon Data="{Binding Icon}" Size="12" Foreground="{Binding Brush}" />
                          <TextBlock Text="{Binding Title}" FontSize="11" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding Count}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                      </ToggleButton>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Flyout>
          </ToggleButton.Flyout>
        </ToggleButton>
        <Button Name="SortButton" Classes="icon small" ToolTip.Tip="Sort">
          <ui:SymbolIcon Data="{x:Static ui:Icons.ChevronsUpDown}" Size="14" />
        </Button>
        <StackPanel Orientation="Horizontal" Spacing="2" Margin="4,0,0,0">
          <ToggleButton Classes="icon small" IsChecked="{Binding IsGrid, Mode=OneWay}" Command="{Binding ShowGridCommand}" ToolTip.Tip="Grid">
            <ui:SymbolIcon Data="{x:Static ui:Icons.Grid}" Size="14" />
          </ToggleButton>
          <ToggleButton Classes="icon small" IsChecked="{Binding IsList, Mode=OneWay}" Command="{Binding ShowListCommand}" ToolTip.Tip="List">
            <ui:SymbolIcon Data="{x:Static ui:Icons.ListTree}" Size="14" />
          </ToggleButton>
        </StackPanel>
      </WrapPanel>
    </ui:SplitBar>
    <Border DockPanel.Dock="Top" Classes="divider-h" />

    <!-- Footer -->
    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Height="26" Padding="10,0">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsScanning}">
            <ProgressBar Width="90" Height="4" MinHeight="4" Minimum="0" Maximum="1" Value="{Binding ScanFraction}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding ScanText}" Classes="caption muted" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="{Binding StatusText}" Classes="caption muted" VerticalAlignment="Center" IsVisible="{Binding !IsScanning}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsGrid}">
          <ui:SymbolIcon Data="{x:Static ui:Icons.Image}" Size="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
          <Slider Width="110" Minimum="48" Maximum="128" Value="{Binding ThumbnailSize}" VerticalAlignment="Center" ToolTip.Tip="Thumbnail size" />
          <ui:SymbolIcon Data="{x:Static ui:Icons.Image}" Size="15" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Name="Body" ColumnDefinitions="200,Auto,*">
      <!-- Folder tree -->
      <TreeView Name="Folders" ItemsSource="{Binding FolderRoots}" SelectedItem="{Binding SelectedFolderNode}" Background="Transparent" Padding="4,6">
        <TreeView.ItemContainerTheme>
          <ControlTheme TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}" x:DataType="vm:FolderNodeViewModel">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
          </ControlTheme>
        </TreeView.ItemContainerTheme>
        <TreeView.ItemTemplate>
          <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="vm:FolderNodeViewModel">
            <Border Classes="node" Classes.drop="{Binding IsDropTarget}" Tag="{Binding}" DragDrop.AllowDrop="True" Background="Transparent">
              <StackPanel Orientation="Horizontal" Spacing="6" Height="22">
                <ui:SymbolIcon Data="{Binding Icon}" Size="13" Foreground="#F59E0B" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Border>
          </TreeDataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>
      <GridSplitter Name="FolderSplitter" Grid.Column="1" Width="1" ResizeDirection="Columns" Background="{DynamicResource BorderSubtleBrush}" />

      <!-- Contents -->
      <Panel Name="ContentArea" Grid.Column="2" Background="Transparent" DragDrop.AllowDrop="True">
        <ScrollViewer Name="GridScroll" IsVisible="{Binding IsGrid}" HorizontalScrollBarVisibility="Disabled" Padding="8,8,4,4">
          <ItemsControl Name="GridItems" ItemsSource="{Binding Rows}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AssetRowViewModel">
                <ItemsControl ItemsSource="{Binding Items}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AssetItemViewModel">
                      <Border Classes="tile" Classes.selected="{Binding IsSelected}" Classes.drop="{Binding IsDropTarget}" Classes.cut="{Binding IsCut}"
                              Width="{Binding $parent[UserControl].((vm:AssetBrowserViewModel)DataContext).TileWidth}" ToolTip.Tip="{Binding Tooltip}"
                              DragDrop.AllowDrop="{Binding IsFolder}">
                        <StackPanel Spacing="5">
                          <Panel Height="{Binding $parent[UserControl].((vm:AssetBrowserViewModel)DataContext).ThumbnailSize}">
                            <Border Classes="thumb">
                              <Panel>
                                <ui:SymbolIcon Data="{Binding Icon}" Size="26" StrokeThickness="1.75" Foreground="{Binding Brush}" IsVisible="{Binding !HasThumbnail}" />
                                <Image Source="{Binding Thumbnail}" Margin="5" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="MediumQuality" />
                              </Panel>
                            </Border>
                            <Border Classes="badge" IsVisible="{Binding HasBadge}">
                              <TextBlock Text="{Binding Badge}" FontSize="9" FontWeight="Bold" LetterSpacing="0.4" Foreground="{Binding Brush}" />
                            </Border>
                            <ui:SymbolIcon Data="{x:Static ui:Icons.Star}" Size="11" Foreground="#F59E0B" IsVisible="{Binding IsFavorite}"
                                           HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5" />
                          </Panel>
                          <Panel Height="20">
                            <TextBlock Classes="title" Text="{Binding Name}" IsVisible="{Binding !IsRenaming}" VerticalAlignment="Center" />
                            <TextBox Classes="rename" Text="{Binding RenameText}" IsVisible="{Binding IsRenaming}" />
                          </Panel>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <DockPanel IsVisible="{Binding IsList}">
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,120,80,130" Margin="40,4,16,2">
            <Button Classes="subtle header" Content="Name" Command="{Binding SetSortCommand}" CommandParameter="{x:Static vm:AssetSortKey.Name}" />
            <Button Grid.Column="1" Classes="subtle header" Content="Kind" Command="{Binding SetSortCommand}" CommandParameter="{x:Static vm:AssetSortKey.Kind}" />
            <Button Grid.Column="2" Classes="subtle header" Content="Size" Command="{Binding SetSortCommand}" CommandParameter="{x:Static vm:AssetSortKey.Size}" />
            <Button Grid.Column="3" Classes="subtle header" Content="Modified" Command="{Binding SetSortCommand}" CommandParameter="{x:Static vm:AssetSortKey.Modified}" />
          </Grid>
          <Border DockPanel.Dock="Top" Classes="divider-h" />
          <ScrollViewer Name="ListScroll" HorizontalScrollBarVisibility="Disabled" Padding="0,4">
            <ItemsControl Name="ListItems" ItemsSource="{Binding Items}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AssetItemViewModel">
                  <Border Classes="row" Classes.selected="{Binding IsSelected}" Classes.drop="{Binding IsDropTarget}" Classes.cut="{Binding IsCut}"
                          DragDrop.AllowDrop="{Binding IsFolder}" ToolTip.Tip="{Binding Path}">
                    <Grid ColumnDefinitions="22,*,120,80,130" ColumnSpacing="6">
                      <Panel Width="20" Height="20">
                        <ui:SymbolIcon Data="{Binding Icon}" Size="14" Foreground="{Binding Brush}" IsVisible="{Binding !HasThumbnail}" />
                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="MediumQuality" />
                      </Panel>
                      <Panel Grid.Column="1">
                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !IsRenaming}">
                          <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          <ui:SymbolIcon Data="{x:Static ui:Icons.Star}" Size="10" Foreground="#F59E0B" IsVisible="{Binding IsFavorite}" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding LabelsText}" Classes="caption" Foreground="{DynamicResource AccentBrush}" IsVisible="{Binding HasLabels}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBox Classes="rename" Text="{Binding RenameText}" IsVisible="{Binding IsRenaming}" HorizontalAlignment="Left" MinWidth="200" />
                      </Panel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                        <Border Width="6" Height="6" CornerRadius="3" Background="{Binding Brush}" VerticalAlignment="Center" />
                        <TextBlock Classes="cell" Text="{Binding KindText}" />
                      </StackPanel>
                      <TextBlock Grid.Column="3" Classes="cell mono" Text="{Binding SizeText}" FontSize="11" />
                      <TextBlock Grid.Column="4" Classes="cell" Text="{Binding ModifiedText}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>

        <ui:EmptyState IsVisible="{Binding IsEmpty}" Icon="{x:Static ui:Icons.FolderOpen}" Title="{Binding EmptyTitle}" Hint="{Binding EmptyHint}" IsHitTestVisible="False" />
        <StackPanel IsVisible="{Binding !IsReady}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
          <ProgressBar IsIndeterminate="True" Width="160" />
          <TextBlock Text="Scanning assets…" Classes="caption muted" HorizontalAlignment="Center" />
        </StackPanel>
        <Border Name="DropZone" Classes="dropzone">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
            <ui:SymbolIcon Data="{x:Static ui:Icons.Import}" Size="28" Foreground="{DynamicResource AccentBrush}" />
            <TextBlock Name="DropText" Text="Drop to import" FontWeight="SemiBold" HorizontalAlignment="Center" />
          </StackPanel>
        </Border>
      </Panel>
    </Grid>
  </DockPanel>
</UserControl>
