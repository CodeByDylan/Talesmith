<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="https://talesmith.dev/ui"
                    xmlns:dock="using:Talesmith.UI.Docking">

  <ControlTheme x:Key="DockHeaderButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusSmall}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Name="PART_ContentPresenter"
                          Background="{TemplateBinding Background}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          Content="{TemplateBinding Content}"
                          Foreground="{TemplateBinding Foreground}"
                          Padding="{TemplateBinding Padding}"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>
    <Style Selector="^:pressed">
      <Setter Property="Background" Value="{DynamicResource SurfacePressedBrush}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type dock:DockTab}" TargetType="dock:DockTab">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Padding" Value="10,0,8,0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="Transparent">
          <Border Name="PART_Background"
                  Margin="2,5"
                  CornerRadius="{DynamicResource CornerRadiusMedium}"
                  Background="Transparent">
            <Border.Transitions>
              <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.08" />
              </Transitions>
            </Border.Transitions>
          </Border>
          <Grid Margin="{TemplateBinding Padding}" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
            <ui:SymbolIcon Name="PART_Icon"
                           Data="{TemplateBinding Icon}"
                           Size="14"
                           Margin="0,0,7,0"
                           Foreground="{TemplateBinding Foreground}"
                           IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Name="PART_Title"
                       Grid.Column="1"
                       Text="{TemplateBinding Title}"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
            <Button Name="PART_CloseButton"
                    Grid.Column="2"
                    Theme="{StaticResource DockHeaderButton}"
                    Width="18"
                    Height="18"
                    Margin="5,0,-3,0"
                    Opacity="0"
                    ToolTip.Tip="Close (middle-click)">
              <ui:SymbolIcon Data="{x:Static ui:Icons.X}" Size="12" StrokeThickness="2.25" />
            </Button>
          </Grid>
          <Border Name="PART_Indicator"
                  Height="2"
                  Margin="10,0"
                  VerticalAlignment="Bottom"
                  CornerRadius="2,2,0,0"
                  Background="{DynamicResource BorderStrongBrush}"
                  IsVisible="False" />
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:not(:closable) /template/ Button#PART_CloseButton">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:compact">
      <Setter Property="Padding" Value="10,0" />
      <Style Selector="^ /template/ TextBlock#PART_Title">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <Style Selector="^ /template/ Button#PART_CloseButton">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <Style Selector="^ /template/ ui|SymbolIcon#PART_Icon">
        <Setter Property="Margin" Value="0" />
      </Style>
    </Style>
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Style Selector="^ /template/ Border#PART_Background">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
      </Style>
      <Style Selector="^ /template/ Button#PART_CloseButton">
        <Setter Property="Opacity" Value="1" />
      </Style>
    </Style>
    <Style Selector="^:active">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Cursor" Value="Arrow" />
      <Style Selector="^ /template/ Border#PART_Indicator">
        <Setter Property="IsVisible" Value="True" />
      </Style>
      <Style Selector="^ /template/ Button#PART_CloseButton">
        <Setter Property="Opacity" Value="1" />
      </Style>
      <Style Selector="^ /template/ ui|SymbolIcon#PART_Icon">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      </Style>
    </Style>
    <Style Selector="^:active:group-focused">
      <Style Selector="^ /template/ Border#PART_Indicator">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      </Style>
      <Style Selector="^ /template/ ui|SymbolIcon#PART_Icon">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      </Style>
    </Style>
    <Style Selector="^:dragging">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type dock:DockGroupView}" TargetType="dock:DockGroupView">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="Template">
      <ControlTemplate>
        <DockPanel Background="{TemplateBinding Background}">
          <Border Name="PART_Header"
                  DockPanel.Dock="Top"
                  Height="34"
                  Padding="4,0,6,0"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{DynamicResource BorderSubtleBrush}"
                  BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
              <dock:DockTabStrip Name="PART_Tabs" HorizontalAlignment="Left" ClipToBounds="True" />
              <ContentPresenter Grid.Column="1"
                                Margin="6,0,2,0"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding HeaderActions}" />
              <Button Name="PART_Overflow"
                      Grid.Column="2"
                      Theme="{StaticResource DockHeaderButton}"
                      IsVisible="False"
                      ToolTip.Tip="All tabs">
                <ui:SymbolIcon Data="{x:Static ui:Icons.ChevronDown}" Size="14" />
              </Button>
              <Button Name="PART_Maximize"
                      Grid.Column="3"
                      Theme="{StaticResource DockHeaderButton}"
                      Margin="2,0,0,0"
                      Opacity="0">
                <ui:SymbolIcon Data="{TemplateBinding MaximizeIcon}" Size="13" />
                <Button.Transitions>
                  <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
                  </Transitions>
                </Button.Transitions>
              </Button>
            </Grid>
          </Border>
          <Panel Name="PART_Content" />
        </DockPanel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:overflowing /template/ Button#PART_Overflow">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^ /template/ Border#PART_Header:pointerover Button#PART_Maximize">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="^:maximized /template/ Button#PART_Maximize">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type dock:DockSplitter}" TargetType="dock:DockSplitter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="ZIndex" Value="1" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="{TemplateBinding Background}">
          <Border Name="PART_Line" Background="{DynamicResource BorderSubtleBrush}">
            <Border.Transitions>
              <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.1" />
              </Transitions>
            </Border.Transitions>
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:horizontal /template/ Border#PART_Line">
      <Setter Property="Width" Value="1" />
    </Style>
    <Style Selector="^:vertical /template/ Border#PART_Line">
      <Setter Property="Height" Value="1" />
    </Style>
    <Style Selector="^:pointerover /template/ Border#PART_Line, ^:dragging /template/ Border#PART_Line">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="^:horizontal:pointerover /template/ Border#PART_Line, ^:horizontal:dragging /template/ Border#PART_Line">
      <Setter Property="Width" Value="2" />
    </Style>
    <Style Selector="^:vertical:pointerover /template/ Border#PART_Line, ^:vertical:dragging /template/ Border#PART_Line">
      <Setter Property="Height" Value="2" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type dock:DockHost}" TargetType="dock:DockHost">
    <Setter Property="Focusable" Value="False" />
  </ControlTheme>
</ResourceDictionary>
