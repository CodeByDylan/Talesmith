<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="https://talesmith.dev/ui">

  <ControlTheme x:Key="SectionHeaderToggle" TargetType="ToggleButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Background="{TemplateBinding Background}"
                          Content="{TemplateBinding Content}"
                          VerticalContentAlignment="Center" />
      </ControlTemplate>
    </Setter>
    <Style Selector="^:disabled">
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type ui:SectionPanel}" TargetType="ui:SectionPanel">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="12,0,12,12" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                Background="{TemplateBinding Background}">
          <DockPanel>
            <Grid Name="PART_HeaderRow"
                  DockPanel.Dock="Top"
                  Height="36"
                  Margin="12,0,8,0"
                  ColumnDefinitions="*,Auto">
              <ToggleButton Theme="{StaticResource SectionHeaderToggle}"
                            IsEnabled="{TemplateBinding IsCollapsible}"
                            IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <ui:SymbolIcon Name="PART_Chevron"
                                 Data="{x:Static ui:Icons.ChevronDown}"
                                 Size="12"
                                 StrokeThickness="2.5"
                                 Margin="-2,0,0,0"
                                 Foreground="{DynamicResource TextMutedBrush}"
                                 IsVisible="{TemplateBinding IsCollapsible}" />
                  <ui:SymbolIcon Data="{TemplateBinding Icon}"
                                 Size="14"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  <ContentPresenter Content="{TemplateBinding Header}"
                                    ContentTemplate="{TemplateBinding HeaderTemplate}"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    VerticalAlignment="Center" />
                </StackPanel>
              </ToggleButton>
              <ContentPresenter Grid.Column="1"
                                Content="{TemplateBinding HeaderActions}"
                                VerticalAlignment="Center" />
            </Grid>
            <ContentPresenter Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </DockPanel>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:collapsed">
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <Style Selector="^ /template/ ui|SymbolIcon#PART_Chevron">
        <Setter Property="RenderTransform" Value="rotate(-90deg)" />
      </Style>
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type ui:SettingRow}" TargetType="ui:SettingRow">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="MinHeight" Value="56" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <ui:SymbolIcon Data="{TemplateBinding Icon}"
                           Size="18"
                           Margin="0,0,14,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
              <TextBlock Text="{TemplateBinding Title}"
                         FontWeight="Medium"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
              <TextBlock Text="{TemplateBinding Description}"
                         FontSize="12"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource TextMutedBrush}"
                         IsVisible="{TemplateBinding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
            <ContentPresenter Grid.Column="2"
                              Margin="16,0,0,0"
                              VerticalAlignment="Center"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type ui:Dialog}" TargetType="ui:Dialog">
    <Setter Property="Width" Value="480" />
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="20,14,20,20" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                BoxShadow="{DynamicResource ShadowPopup}">
          <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="20,18,12,0" ColumnDefinitions="*,Auto">
              <StackPanel Spacing="4" VerticalAlignment="Center">
                <ContentPresenter Content="{TemplateBinding Header}"
                                  ContentTemplate="{TemplateBinding HeaderTemplate}"
                                  FontSize="{DynamicResource FontSizeSubtitle}"
                                  FontWeight="SemiBold" />
                <TextBlock Text="{TemplateBinding Description}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           IsVisible="{TemplateBinding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
              <Button Name="PART_CloseButton"
                      Grid.Column="1"
                      Classes="icon"
                      Margin="8,-6,0,0"
                      VerticalAlignment="Top"
                      IsVisible="{TemplateBinding ShowCloseButton}"
                      ToolTip.Tip="Close">
                <ui:SymbolIcon Data="{x:Static ui:Icons.X}" Size="16" />
              </Button>
            </Grid>
            <Border DockPanel.Dock="Bottom"
                    Background="{DynamicResource SurfaceHoverBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,11,11"
                    Padding="16,12"
                    IsVisible="{TemplateBinding Footer, Converter={x:Static ObjectConverters.IsNotNull}}">
              <ContentPresenter Content="{TemplateBinding Footer}" HorizontalAlignment="Right" />
            </Border>
            <ScrollViewer Name="PART_Scroller" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <ContentPresenter Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" />
            </ScrollViewer>
          </DockPanel>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:fixed-height /template/ ScrollViewer#PART_Scroller">
      <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
