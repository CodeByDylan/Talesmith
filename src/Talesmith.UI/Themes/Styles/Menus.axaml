<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="Menu">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Height" Value="{DynamicResource MenuBarHeight}" />
  </Style>
  <Style Selector="Menu > MenuItem">
    <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusSmall}" />
    <Setter Property="Padding" Value="{DynamicResource MenuBarItemPadding}" />
    <Setter Property="Margin" Value="1,0" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="Menu > MenuItem:pointerover, Menu > MenuItem:open">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Menu > MenuItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>

  <Style Selector="MenuFlyoutPresenter, ContextMenu">
    <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="{DynamicResource MenuFlyoutPresenterThemePadding}" />
    <Setter Property="MinWidth" Value="200" />
  </Style>

  <Style Selector="MenuItem">
    <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusSmall}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
  </Style>
  <Style Selector="MenuItem /template/ TextBlock#PART_InputGestureText">
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="MenuItem:disabled">
    <Setter Property="Opacity" Value="1" />
  </Style>
</Styles>
