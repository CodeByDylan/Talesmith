<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="ListBox.sidebar">
    <Setter Property="Padding" Value="6,4" />
  </Style>
  <Style Selector="ListBox.sidebar ListBoxItem">
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="ListBox.sidebar ListBoxItem:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="ListBox.sidebar ListBoxItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="ListBox.sidebar ListBoxItem:selected /template/ Border#PART_Indicator">
    <Setter Property="IsVisible" Value="True" />
  </Style>

  <Style Selector="TabControl">
    <Setter Property="Padding" Value="0" />
  </Style>
</Styles>
