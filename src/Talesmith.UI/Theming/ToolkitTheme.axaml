<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Talesmith.UI.Theming.ToolkitTheme">
  <FluentTheme DensityStyle="Compact" />

  <StyleInclude Source="avares://Talesmith.UI/Themes/Styles/Typography.axaml" />
  <StyleInclude Source="avares://Talesmith.UI/Themes/Styles/Surfaces.axaml" />
  <StyleInclude Source="avares://Talesmith.UI/Themes/Styles/Inputs.axaml" />
  <StyleInclude Source="avares://Talesmith.UI/Themes/Styles/Menus.axaml" />
  <StyleInclude Source="avares://Talesmith.UI/Themes/Styles/Lists.axaml" />
  <StyleInclude Source="avares://Talesmith.UI/Themes/Styles/Editor.axaml" />

  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Talesmith.UI/Themes/Metrics.axaml" />
        <ResourceInclude Source="avares://Talesmith.UI/Themes/Controls/Buttons.axaml" />
        <ResourceInclude Source="avares://Talesmith.UI/Themes/Controls/Items.axaml" />
        <ResourceInclude Source="avares://Talesmith.UI/Themes/Controls/Primitives.axaml" />
        <ResourceInclude Source="avares://Talesmith.UI/Themes/Controls/Panels.axaml" />
        <ResourceInclude Source="avares://Talesmith.UI/Themes/Controls/Overlays.axaml" />
        <ResourceInclude Source="avares://Talesmith.UI/Themes/Controls/ColorPicker.axaml" />
        <ResourceInclude Source="avares://Talesmith.UI/Themes/Controls/Fields.axaml" />
        <ResourceInclude Source="avares://Talesmith.UI/Themes/Controls/Tree.axaml" />
        <ResourceInclude Source="avares://Talesmith.UI/Themes/Controls/Editor.axaml" />
        <ResourceInclude Source="avares://Talesmith.UI/Themes/Controls/Docking.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Styles.Resources>
</Styles>
