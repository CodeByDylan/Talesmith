<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <Authors>Dylan de Beer</Authors>
    <Product>Talesmith</Product>
    <Copyright>Copyright 2026 Dylan de Beer</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://talesmith.dev</PackageProjectUrl>
    <RepositoryUrl>https://github.com/CodeByDylan/Talesmith</RepositoryUrl>
    <!-- Releases set TalesmithVersion from the tag, as an environment variable, so it reaches the players the editor publishes too. -->
    <TalesmithVersion Condition="'$(TalesmithVersion)' == ''">0.1.0</TalesmithVersion>
    <Version>$(TalesmithVersion)</Version>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsTestProject)' != 'true' and '$(IsBenchmarkProject)' != 'true'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573;CA1051;CA1716;CA1720</NoWarn>
  </PropertyGroup>

  <!-- Rejects calls that are easy to get wrong; BannedSymbols.txt says why for each one and what to use instead. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
  </ItemGroup>

  <!-- Lets CI save a dump of a test run that hangs and stop it. Items see the project's own properties, so this reaches every test project. -->
  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <PackageReference Include="Microsoft.Testing.Extensions.HangDump" />
  </ItemGroup>
</Project>
