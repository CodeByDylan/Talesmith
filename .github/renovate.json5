// Renovate opens a pull request for each dependency update. It never merges one: every update waits for green CI and a review.
// Pending updates are listed in the Dependency Dashboard issue. Its commits follow Conventional Commits, as every commit must.
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended', 'helpers:pinGitHubActionDigests', ':semanticCommits', ':semanticCommitTypeAll(chore)'],
  automerge: false,
  timezone: 'Europe/Amsterdam',
  schedule: ['before 9am on monday'],
  prConcurrentLimit: 10,
  prHourlyLimit: 5,
  labels: ['dependencies'],
  osvVulnerabilityAlerts: true,
  vulnerabilityAlerts: {
    labels: ['dependencies', 'security'],
    schedule: ['at any time'],
  },
  lockFileMaintenance: {
    enabled: true,
    schedule: ['before 9am on the first day of the month'],
  },
  // Keeps flake.lock's nixpkgs, which the Nix package takes its libraries from, current with the monthly lock file maintenance.
  nix: {
    enabled: true,
  },
  packageRules: [
    {
      description: 'Updates to the actions change the workflows, so their commits are ci(deps) rather than chore(deps).',
      matchManagers: ['github-actions'],
      semanticCommitType: 'ci',
    },
    {
      description: 'Give new npm releases three days, in which a broken or compromised release is usually pulled.',
      matchDatasources: ['npm'],
      minimumReleaseAge: '3 days',
    },
    {
      description: 'Keep Roslyn with the SDK: the SDK compiler skips analyzers built for a newer Roslyn (CS9057).',
      matchPackageNames: ['Microsoft.CodeAnalysis.CSharp', 'dotnet-sdk'],
      groupName: 'Roslyn and the .NET SDK',
      prBodyNotes: [
        'The script analyzers build against `Microsoft.CodeAnalysis.CSharp`, and the SDK in `global.json` must ship a compiler at least that new. If `TheGeneratedProjectBuildsWithDotnetBuild` fails with CS9057, this pull request waits for an SDK with that compiler.',
      ],
    },
    {
      description: 'global.json sets the oldest SDK that builds the repository, and CI installs the newest one anyway, so only a new feature band raises it.',
      matchPackageNames: ['dotnet-sdk'],
      allowedVersions: '/^\\d+\\.\\d+\\.\\d00$/',
    },
    {
      description: 'Microsoft.Extensions packages share MicrosoftExtensionsVersion, apart from Roslyn and the SDK.',
      matchPackageNames: ['Microsoft.Extensions.*'],
      groupName: 'Microsoft.Extensions',
    },
    {
      description: 'xUnit and the Microsoft Testing Platform move together.',
      matchPackageNames: ['xunit.v3', 'xunit.runner.visualstudio', 'Microsoft.NET.Test.Sdk', 'Microsoft.Testing.*'],
      groupName: 'xUnit and the test platform',
    },
    {
      matchPackageNames: ['react', 'react-dom', '@types/react'],
      groupName: 'React',
    },
    {
      description: 'A new shader compiler can change the committed SPIR-V.',
      matchPackageNames: ['Vortice.ShaderCompiler'],
      prBodyNotes: [
        'Run `dotnet run --project tools/Talesmith.ShaderCompiler` and commit any `.spv` file that changes.',
      ],
    },
    {
      description: 'Moving to the next .NET release is a decision, so these majors wait for approval on the dashboard.',
      matchPackageNames: ['dotnet-sdk', 'Microsoft.CodeAnalysis.CSharp', 'Microsoft.Extensions.*'],
      matchUpdateTypes: ['major'],
      dependencyDashboardApproval: true,
    },
    {
      description: 'Avalonia builds on one SkiaSharp major, so their majors move together, on purpose.',
      matchPackageNames: ['Avalonia', 'Avalonia.*', 'SkiaSharp', 'SkiaSharp.*'],
      matchUpdateTypes: ['major'],
      dependencyDashboardApproval: true,
    },
  ],
}
